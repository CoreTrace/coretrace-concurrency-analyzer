# Download policy for the LLVM installer, shared by the container builds and
# the Ubuntu runners (.github/actions/install-llvm-apt). It is appended to
# /etc/wgetrc rather than passed on the command line because the call that
# fails is usually not ours: llvm.sh probes apt.llvm.org with its own
# `wget --method=HEAD` and fetches the signing key with another wget, and reads
# an unreachable host as "your distribution is not supported". A flag on our
# invocation would never reach those.

# apt.llvm.org is dual-stack, and the network a container gets during a build
# can resolve its AAAA record without having a route to it. wget does not fall
# back to IPv4 once it has picked that address, so it fails outright -- while
# apt, which does fall back, pulls packages from the same host without trouble.
inet4_only = on

# Bounded retries for a genuinely transient failure: at most five attempts,
# ten seconds apart, each giving up after thirty seconds without progress.
tries = 5
waitretry = 10
retry_connrefused = on
timeout = 30
